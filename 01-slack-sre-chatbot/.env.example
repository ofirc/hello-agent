# Copy to .env and fill in. .env is gitignored, .env.example is not.
#
#   cp .env.example .env
#   vim .env
#   set -a && source .env && set +a     # -a exports everything the file defines
#   go run ./cmd/agent
#
# Only the two Slack values are required to boot. Every provider degrades to "not
# configured", so the agent starts with whatever you have and /sre doctor tells you what
# is missing. That is deliberate: a bot that starts and explains itself beats one that
# crash-loops on a Cloud Run instance you then have to SSH into.
#
# Booting is not the same as being useful. A model (Vertex AI or Ollama, below) is
# required for `drift debug` and `drift fix`: without one those two commands say they need
# it.
#
# Running on the local kind stack? Don't fill this file in for that: ./deploy/local/up.sh
# reads your Slack and GitHub tokens from .env and writes every local setting into
# .env.local for you (see "Run it locally on kind" in the README).

# ---- Slack (required) -------------------------------------------------------
# Install App -> Install to <workspace> -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-

# Basic Information -> App-Level Tokens -> Generate, scope connections:write.
# Not the Client Secret, not the Signing Secret. Socket Mode will not start without it.
SLACK_APP_TOKEN=xapp-

# ---- GitHub: desired state and fix PRs --------------------------------------
# Fine-grained PAT scoped to this one repo: Contents read/write, Pull requests
# read/write. Nothing else. A classic `repo` token works but grants far too much.
GITHUB_TOKEN=
GITHUB_OWNER=ofirc
GITHUB_REPO=hello-agent
GITHUB_BASE_BRANCH=main
GITOPS_PREFIX=01-slack-sre-chatbot/gitops/overlays

# ---- Argo CD: actual cluster state ------------------------------------------
# Leave these two empty. deploy/03-argocd.sh mints the token and writes both values
# here for you, so 04-agent.sh picks them up with nothing to copy by hand.
#
# The address it writes is an internal load balancer, reachable from the Cloud Run
# instance over Direct VPC egress but not from your laptop. To run locally, override it:
#   kubectl port-forward -n argocd svc/argocd-server 8080:443 &
#   ARGOCD_BASE_URL=https://localhost:8080 go run ./cmd/agent
ARGOCD_BASE_URL=
ARGOCD_TOKEN=
ARGOCD_PROJECT=default

# Argo CD serves a self-signed certificate out of the box, so a correct TLS client
# refuses to talk to it. Set false once argocd-server has a certificate the agent
# trusts. Scoped to the Argo CD provider only.
ARGOCD_INSECURE=true

# ---- Grafana (optional): is the drift hurting anyone ------------------------
GRAFANA_BASE_URL=
GRAFANA_TOKEN=
GRAFANA_DATASOURCE_UID=

# ---- JIRA (optional): has anyone already reported it ------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT=

# ---- Model (required for drift debug and drift fix) --------------------------
# The model runs both commands, and there is no rule-based fallback: with no model
# configured they answer that they need one. Everything else works without it.
#
# Which provider: vertex or ollama. Empty means "vertex" when VERTEX_PROJECT is set and
# no model otherwise. An unknown value, or vertex without VERTEX_PROJECT, stops the agent
# at startup.
MODEL_PROVIDER=

# Vertex AI. Uses Application Default Credentials, so there is no key here. Locally that
# means `gcloud auth application-default login`; on Cloud Run it is the attached service
# account. VERTEX_MODEL can be changed if the default is not served to your project.
VERTEX_PROJECT=
VERTEX_LOCATION=us-east1
VERTEX_MODEL=gemini-2.5-pro

# Ollama, for the local stack. Not read unless MODEL_PROVIDER=ollama.
# OLLAMA_BASE_URL: the OpenAI-compatible endpoint, including /v1. Default
#   http://localhost:11434/v1. From a container use http://host.docker.internal:11434/v1,
#   which compose.yaml sets for you.
# OLLAMA_MODEL: default sre-qwen3:14b, the qwen3:14b variant with a 32K context window
#   that up.sh creates. Ollama's default context is too small for the debug prompt and
#   cuts it from the front without an error.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=sre-qwen3:14b

# ---- Code execution (optional) -------------------------------------------------
# Where the model's run_code scripts run: cloudrun (the Cloud Run sandbox CLI), docker (a
# throwaway container with no network), shim (deploy/local/sandbox-shim standing in for
# the Cloud Run CLI: the same runner code, NO isolation, local use only), or auto (Cloud
# Run when its CLI is present, otherwise Docker when it works, otherwise none; never the
# shim). Default auto. With none, the model investigates without run_code. up.sh sets
# shim for the local stack.
SANDBOX=auto
# The Cloud Run CLI the cloudrun and shim runners execute. Default
# /usr/local/gcp/bin/sandbox, where Cloud Run mounts it. up.sh points it at the shim.
SANDBOX_CLI=/usr/local/gcp/bin/sandbox
# The image Docker code runs start from. Default sre-agent:local, the agent's own
# runtime image (it has python3 and bash). up.sh builds it.
SANDBOX_IMAGE=sre-agent:local
# Where the agent writes each run's evidence files. Default: sre-runs under the OS temp
# directory. With the Docker runner this must be an absolute path that is the same on the
# host and inside the agent's container; up.sh sets it to <this directory>/.local/runs, and
# compose.docker-sandbox.yaml mounts it at that path.
AGENT_WORKDIR=

# ---- Behaviour ---------------------------------------------------------------
# Ordered least to most production-like. The last one is treated as production: it is
# the PROD column, it sorts first in drift output, and each environment is compared with
# the one before it.
ENVIRONMENTS=test,stage,prod

# Environments /sre drift fix is allowed to open PRs against.
ALLOW_FIX_ENVS=stage,prod

# Slack account emails allowed to run the restricted commands: drift debug, drift fix,
# doctor, and the Open this PR / Cancel buttons. Comma-separated, case does not matter.
# Empty means NOBODY may run them (the gate fails closed). Everything else stays open.
AUTHORIZED_EMAILS=

# Set to false only if you want the agent to merge its own PRs. Do not.
REQUIRE_APPROVE=true
