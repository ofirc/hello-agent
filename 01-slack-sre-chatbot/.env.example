# Copy to .env and fill in. .env is gitignored, .env.example is not.
#
#   cp .env.example .env
#   vim .env
#   set -a && source .env && set +a     # -a exports everything the file defines
#   go run ./cmd/agent
#
# Only the two Slack values are required. Every provider degrades to "not configured",
# so the agent boots with whatever you have and /sre doctor tells you what is missing.
# That is deliberate: a bot that starts and explains itself beats one that crash-loops
# on a Cloud Run instance you then have to SSH into.

# ---- Slack (required) -------------------------------------------------------
# Install App -> Install to <workspace> -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-

# Basic Information -> App-Level Tokens -> Generate, scope connections:write.
# Not the Client Secret, not the Signing Secret. Socket Mode will not start without it.
SLACK_APP_TOKEN=xapp-

# ---- GitHub: desired state and fix PRs --------------------------------------
# Fine-grained PAT scoped to this one repo: Contents read/write, Pull requests
# read/write. Nothing else. A classic `repo` token works but grants far too much.
GITHUB_TOKEN=
GITHUB_OWNER=ofirc
GITHUB_REPO=hello-agent
GITHUB_BASE_BRANCH=main
GITOPS_PREFIX=01-slack-sre-chatbot/gitops/overlays

# ---- Argo CD: actual cluster state ------------------------------------------
# Leave these two empty. deploy/03-argocd.sh mints the token and writes both values
# here for you, so 04-agent.sh picks them up with nothing to copy by hand.
#
# The address it writes is an internal load balancer, reachable from the Cloud Run
# instance over Direct VPC egress but not from your laptop. To run locally, override it:
#   kubectl port-forward -n argocd svc/argocd-server 8080:443 &
#   ARGOCD_BASE_URL=https://localhost:8080 go run ./cmd/agent
ARGOCD_BASE_URL=
ARGOCD_TOKEN=
ARGOCD_PROJECT=default

# Argo CD serves a self-signed certificate out of the box, so a correct TLS client
# refuses to talk to it. Set false once argocd-server has a certificate the agent
# trusts. Scoped to the Argo CD provider only.
ARGOCD_INSECURE=true

# ---- Grafana (optional): is the drift hurting anyone ------------------------
GRAFANA_BASE_URL=
GRAFANA_TOKEN=
GRAFANA_DATASOURCE_UID=

# ---- JIRA (optional): has anyone already reported it ------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT=

# ---- Vertex AI (optional): root-cause narration -----------------------------
# Uses Application Default Credentials, so there is no key here. Locally that means
# `gcloud auth application-default login`; on Cloud Run it is the attached service
# account. Leave VERTEX_PROJECT empty to use the deterministic narrative instead.
VERTEX_PROJECT=
VERTEX_LOCATION=us-east1
VERTEX_MODEL=gemini-2.5-pro

# ---- Behaviour ---------------------------------------------------------------
# Ordered least to most production-like. The last one is treated as production for
# severity ranking and for the PROD column.
ENVIRONMENTS=test,stage,prod

# Environments /sre drift fix is allowed to open PRs against.
ALLOW_FIX_ENVS=stage,prod

# Set to false only if you want the agent to merge its own PRs. Do not.
REQUIRE_APPROVE=true
